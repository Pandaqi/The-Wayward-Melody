  .show-s {
    display: none;
  }
  .show-m {
    display: none;
  }
  @media all and (max-width: 320px) {
    .hide-s {
      display: none;
    }
    .show-s {
      display: block;
    }
    .flex-wrap-below-s {
      flex-wrap: wrap;
    }
  }
  @media all and (max-width: 640px) {
    .hide-m {
      display: none;
    }
    .show-m {
      display: block;
    }
    .navigation-link::after {
      display: none;
    }
    .navigation-link::before {
      display: none;
    }
    .flex-wrap-below-m {
      flex-wrap: wrap;
    }
  }
}