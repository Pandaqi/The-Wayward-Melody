@font-face{font-family:"Gloria";src:url("fonts/Gloria.woff2") format("woff2");font-weight:normal;font-style:normal;font-display:swap}@font-face{font-family:"Lora";src:url("fonts/Lora-MediumItalic.woff2") format("woff2");font-weight:400;font-style:italic;font-display:swap}@font-face{font-family:"Lora";src:url("fonts/Lora-Medium.woff2") format("woff2");font-weight:400;font-style:normal;font-display:swap}@font-face{font-family:"Lora";src:url("fonts/Lora-BoldItalic.woff2") format("woff2");font-weight:bold;font-style:italic;font-display:swap}@font-face{font-family:"Lora";src:url("fonts/Lora-Bold.woff2") format("woff2");font-weight:bold;font-style:normal;font-display:swap}body{background-color:#EDEDED;color:#121212;font-family:"Lora";font-size:20px;line-height:150%}a{color:black}main{max-width:960px;padding:1.0rem;margin:auto}h1,h2,h3,h4,h5,h6{font-family:Primitive;line-height:100%;font-weight:normal}img{break-before:always}.pagedjs_margin-bottom-center{font-family:"Gloria";font-size:1.3em;color:#AAA}h1,.custom-chapter-header{font-size:4.0rem;margin-bottom:3.5em;text-align:center}.reader h1,.custom-chapter-header{string-set:title content(text);font-size:30pt}.chapter-decoration{break-before:page;z-index:-1;position:relative;margin-bottom:-14em}.force-right{break-before:right}.cover-text{break-before:left}.cover-text .cover-title{margin-top:150pt;text-align:center;font-size:3em}.cover-text .cover-author{margin-top:15pt;text-align:center;font-style:italic}.cover-text .cover-metadata{text-align:center;font-style:italic}.table-of-contents a::after,.reader a::after{content:" (page " target-counter(attr(href), page) ")";font-style:italic}.reader{max-width:550px}.reader p+p{text-indent:2.25rem}.reader p{margin-top:0;margin-bottom:0}hr{margin-top:1.25em;margin-bottom:1.25em;width:50%;max-width:50%;border-style:solid;border-color:#CCCCCC;border-width:0.05em}.summary{background-color:#BABABA;border-radius:0.5rem;transition:background-color 0.3s;margin-top:1.0rem;margin-bottom:1.0rem}.summary:hover{background-color:white}.summary a{text-decoration:none;padding:1.0rem;display:block;margin:0;color:#121212}.summary h1{margin-top:1.0rem}.remark{font-style:italic;opacity:0.66}blockquote{border-left:5px solid grey;padding-left:5px}blockquote p+p{text-indent:0}img{max-width:100%;margin-top:1em;margin-bottom:1em}
